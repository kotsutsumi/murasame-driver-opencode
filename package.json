{
  "name": "@murasame/driver-opencode",
  "version": "0.1.0",
  "description": "A process and control driver for headless OpenCode JSON event executions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kotsutsumi/murasame-driver-opencode.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run test",
    "example:hello": "bun run examples/hello.ts",
    "example:tool": "bun run examples/tool.ts",
    "example:reasoning": "bun run examples/reasoning.ts",
    "example:cancel": "bun run examples/cancel.ts",
    "example:multi-run": "bun run examples/multi-run.ts"
  },
  "dependencies": {
    "@murasame/adapter-opencode": "file:../murasame-adapter-opencode",
    "@murasame/protocol": "file:../murasame-protocol",
    "@murasame/runtime": "file:../murasame-runtime"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "bun-types": "^1.3.9",
    "typescript": "^5.9.2"
  }
}
